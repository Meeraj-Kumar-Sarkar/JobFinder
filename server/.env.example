# ==========================================
# Server Environment Variables (Template)
# ==========================================

# Port (Cloud providers like Render/Railway automatically assign this)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Your deployed frontend URL (used for CORS)
# e.g., https://your-project.vercel.app or http://localhost:5173
CLIENT_URL=

# MongoDB Atlas Connection String (Required)
# e.g., mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jobportal?retryWrites=true&w=majority
MONGODB_URI=

# Custom JWT Secret Key (Optional - will use a fallback if not provided)
JWT_SECRET=

# Firebase Admin SDK Credentials (Optional - only if using Firebase Auth sync)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
